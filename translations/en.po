# 分类名
msgctxt "FastLevelUp.STRINGS.OPTIONS.CATEGORY_LEVEL.NAME"
msgid "Level"
msgstr "Level"

msgctxt "FastLevelUp.STRINGS.OPTIONS.CATEGORY_SPEED.NAME"
msgid "Leveling Speed"
msgstr "Leveling Speed"

# 等级上限
msgctxt "FastLevelUp.STRINGS.OPTIONS.MAX_LEVEL.NAME"
msgid "Max Level"
msgstr "Max Level"

msgctxt "FastLevelUp.STRINGS.OPTIONS.MAX_LEVEL.TOOLTIP"
msgid ""
"Highest skill level a duplicant can reach. Default: 50.\n"
"\n"
"The cap only limits further leveling; duplicants already above it keep their levels and attribute bonuses."
msgstr ""
"Highest skill level a duplicant can reach. Default: 50.\n"
"\n"
"The cap only limits further leveling; duplicants already above it keep their levels and attribute bonuses."

# 预算随上限缩放
msgctxt "FastLevelUp.STRINGS.OPTIONS.SCALE_BUDGET_WITH_CAP.NAME"
msgid "Scale Cost With Cap"
msgstr "Scale Cost With Cap"

msgctxt "FastLevelUp.STRINGS.OPTIONS.SCALE_BUDGET_WITH_CAP.TOOLTIP"
msgid ""
"Off (default): reaching the cap always takes the same total practice, no matter how high the cap is.\n"
"On: raising the cap multiplies the total practice needed by the same amount, so a higher cap costs proportionally more.\n"
"\n"
"Only matters when Max Level is above 50. Default: off."
msgstr ""
"Off (default): reaching the cap always takes the same total practice, no matter how high the cap is.\n"
"On: raising the cap multiplies the total practice needed by the same amount, so a higher cap costs proportionally more.\n"
"\n"
"Only matters when Max Level is above 50. Default: off."

# 满级练习周期
msgctxt "FastLevelUp.STRINGS.OPTIONS.TARGET_CYCLE.NAME"
msgid "Cycles to Max Level"
msgstr "Cycles to Max Level"

msgctxt "FastLevelUp.STRINGS.OPTIONS.TARGET_CYCLE.TOOLTIP"
msgid ""
"Practice cycles needed to go from level 0 to the cap. Lower is faster.\n"
"\n"
"This is not calendar time: experience only builds while a duplicant works, and is multiplied by the job type (1-4x) and training speed. Real calendar time usually ends up around 1.5-2x this number.\n"
"\n"
"Default: 150."
msgstr ""
"Practice cycles needed to go from level 0 to the cap. Lower is faster.\n"
"\n"
"This is not calendar time: experience only builds while a duplicant works, and is multiplied by the job type (1-4x) and training speed. Real calendar time usually ends up around 1.5-2x this number.\n"
"\n"
"Default: 150."

# 升级速度倍率
msgctxt "FastLevelUp.STRINGS.OPTIONS.SPEED_MULTIPLIER.NAME"
msgid "Leveling Speed"
msgstr "Leveling Speed"

msgctxt "FastLevelUp.STRINGS.OPTIONS.SPEED_MULTIPLIER.TOOLTIP"
msgid ""
"Global multiplier on how fast duplicants level up:\n"
"2 = experience needed is halved, 1 = unchanged, 0.5 = doubled.\n"
"\n"
"Default: 1."
msgstr ""
"Global multiplier on how fast duplicants level up:\n"
"2 = experience needed is halved, 1 = unchanged, 0.5 = doubled.\n"
"\n"
"Default: 1."

# 经验曲线陡峭度
msgctxt "FastLevelUp.STRINGS.OPTIONS.EXP_CURVE_POWER.NAME"
msgid "Curve Steepness"
msgstr "Curve Steepness"

msgctxt "FastLevelUp.STRINGS.OPTIONS.EXP_CURVE_POWER.TOOLTIP"
msgid ""
"Shape of the experience curve:\n"
"1 = every level costs the same practice (linear).\n"
"Above 1 = each level costs more than the last (vanilla feel).\n"
"Below 1 = early levels are slow, later ones speed up.\n"
"\n"
"Default: 1.8."
msgstr ""
"Shape of the experience curve:\n"
"1 = every level costs the same practice (linear).\n"
"Above 1 = each level costs more than the last (vanilla feel).\n"
"Below 1 = early levels are slow, later ones speed up.\n"
"\n"
"Default: 1.8."

# 溢出经验结转
msgctxt "FastLevelUp.STRINGS.OPTIONS.CARRY_OVER_SURPLUS.NAME"
msgid "Carry Over Surplus XP"
msgstr "Carry Over Surplus XP"

msgctxt "FastLevelUp.STRINGS.OPTIONS.CARRY_OVER_SURPLUS.TOOLTIP"
msgid ""
"On (default): experience beyond the level requirement is kept toward the next level.\n"
"Off: surplus experience is discarded and only one level can be gained per tick, so very high speed multipliers stop helping.\n"
"\n"
"Default: on."
msgstr ""
"On (default): experience beyond the level requirement is kept toward the next level.\n"
"Off: surplus experience is discarded and only one level can be gained per tick, so very high speed multipliers stop helping.\n"
"\n"
"Default: on."
